# Anthropic API Key (Required)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Fish Audio API Key (Required for voice input)
# Get from: https://fish.audio/
FISH_AUDIO_API_KEY=xxxxxxxxxxxxx

# Reka API Key (Optional - for research agent)
# Get from: https://platform.reka.ai/
REKA_API_KEY=xxxxxxxxxxxxx

# Production Settings
ENVIRONMENT=development
PORT=8000

# CORS Settings (for production)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend-url.vercel.app
